// Windows resources: program icon and version information.
// Configured by src/CMakeLists.txt.
#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/generatedSources/windows/cumtempore.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Akaflieg Freiburg"
            VALUE "FileDescription",  "@DISPLAY_NAME@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@PROJECT_NAME@"
            VALUE "LegalCopyright",   "GNU General Public License V3"
            VALUE "OriginalFilename", "@PROJECT_NAME@.exe"
            VALUE "ProductName",      "@DISPLAY_NAME@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
